# ===========================================
# バックエンド環境変数設定（本番用）
# ===========================================
# このファイルを .env にコピーして値を設定してください
# cp env.example .env

# -------------------------------------------
# データベース設定
# -------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@db:5432/marketing_planner

# -------------------------------------------
# AI API キー（必須）
# -------------------------------------------
# Google Gemini API キー
# 取得先: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# -------------------------------------------
# 外部API キー（オプション）
# -------------------------------------------
MANUS_API_KEY=
V0_API_KEY=
NANO_BANANA_API_KEY=

# Dify API設定（口コミ収集機能用）
DIFY_API_URL=http://your-dify-host/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx

# -------------------------------------------
# アプリケーション設定
# -------------------------------------------
APP_NAME=Marketing Planner API
APP_VERSION=1.0.0
DEBUG=False

# -------------------------------------------
# CORS設定
# -------------------------------------------
# 本番環境のドメイン
CORS_ORIGINS=https://ai-marketing.poseidon-inc.com

# -------------------------------------------
# JWT認証設定
# -------------------------------------------
# 重要: 本番環境では必ず強力なシークレットキーに変更してください
# 生成コマンド: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# S3互換ストレージ（施設画像保存用）
# -------------------------------------------
# Docker 内: http://storage:9000 / ローカル: http://localhost:9000
S3_ENDPOINT_URL=http://storage:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=facility-images

# -------------------------------------------
# 初期管理者設定（オプション）
# -------------------------------------------
INITIAL_ADMIN_EMAIL=admin@poseidon-inc.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password
